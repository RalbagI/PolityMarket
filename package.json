{
  "name": "politymarket",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-politician-names-he.js && node scripts/generate-compact-artifacts.js",
    "build": "vite build",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,json}\" \"tests/**/*.{js,jsx,ts,tsx,css,json}\" \"data-pipeline/**/*.{js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,json}\" \"tests/**/*.{js,jsx,ts,tsx,css,json}\" \"data-pipeline/**/*.{js,jsx,json}\"",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage --reporter=default",
    "test:unit": "vitest run --config vitest.unit.config.js --coverage",
    "test:component": "vitest run --config vitest.component.config.js --coverage",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:integration:coverage": "vitest run --config vitest.integration.config.js --coverage",
    "test:e2e": "playwright test",
    "test:pyramid": "npm run test:unit && npm run test:component && npm run test:integration && npm run test:e2e",
    "playwright:install": "playwright install chromium",
    "preview": "vite preview",
    "pipeline": "node data-pipeline/generateDailyScores.js",
    "pipeline:validate": "node scripts/generate-compact-artifacts.js && node scripts/validate-daily-artifacts.js",
    "pipeline:backfill": "node scripts/backfill-historical-artifacts.js",
    "pipeline:run": "bash scripts/run-daily-pipeline.sh"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "date-fns": "^4.4.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-is": "^19.2.8",
    "react-window": "^2.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.1",
    "babel-plugin-react-remove-properties": "^0.3.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.2.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.1"
  }
}
