{
  "name": "politymarket-functions",
  "description": "Cloud Functions for PolityMarket daily pipeline",
  "type": "module",
  "scripts": {
    "build:manifest": "node scripts/generate-manifest.mjs",
    "serve": "firebase emulators:start --only functions",
    "deploy": "npm run build:manifest && firebase deploy --only functions"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^14.1.0",
    "firebase-functions": "^7.2.5"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "fast-xml-parser": "5.5.10",
    "node-forge": "1.4.0",
    "teeny-request": "10.1.2",
    "http-proxy-agent": "7.0.2"
  }
}
