TZ=Asia/Jerusalem

# Local Ollama endpoint and pinned model
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=120000

# Source ingestion config
PIPELINE_SOURCES_PATH=./data-pipeline/sources.config.json
SOURCE_TIMEOUT_MS=20000

# Production expectation: score all 120 politicians
PIPELINE_EXPECTED_POLITICIAN_COUNT=120

# Git auth for unattended push (optional when SSH deploy key is configured)
# GITHUB_TOKEN=ghp_xxx
