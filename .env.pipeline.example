TZ=Asia/Jerusalem

# Claude CLI configuration for LLM scoring
# Uses batched scoring with prompt-size guardrails.
CLAUDE_MODEL=opus
CLAUDE_TIMEOUT_MS=300000
CLAUDE_MAX_BATCH=135
CLAUDE_MAX_PROMPT_CHARS=350000

# Source ingestion config
PIPELINE_SOURCES_PATH=./data-pipeline/sources.config.json
SOURCE_TIMEOUT_MS=20000
PIPELINE_MAX_FETCH_FAILURES=0

# Production expectation: score all 135 politicians
PIPELINE_EXPECTED_POLITICIAN_COUNT=135

# Git auth for unattended git fetch/pull/push.
# Required for the systemd-user timer: a headless user session can't reach the
# desktop keyring, so `gh auth git-credential` returns empty and git fails. The
# pipeline falls back to `gh auth token` if this is unset, which only works when
# the service runs in a session that shares the keyring with `gh`.
GITHUB_TOKEN=ghp_xxx
