TZ=Asia/Jerusalem

# Claude CLI configuration for LLM scoring
# Uses batched scoring with prompt-size guardrails.
CLAUDE_MODEL=opus
CLAUDE_TIMEOUT_MS=300000
CLAUDE_MAX_BATCH=135
CLAUDE_MAX_PROMPT_CHARS=350000

# Source ingestion config
PIPELINE_SOURCES_PATH=./data-pipeline/sources.config.json
SOURCE_TIMEOUT_MS=20000
PIPELINE_MAX_FETCH_FAILURES=0

# Production expectation: score all 135 politicians
PIPELINE_EXPECTED_POLITICIAN_COUNT=135

# Git auth for unattended push (optional when SSH deploy key is configured)
# GITHUB_TOKEN=ghp_xxx
