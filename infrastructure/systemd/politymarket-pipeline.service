[Unit]
Description=PolityMarket Daily Data Pipeline
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/botipi-4/PoliticMarket
EnvironmentFile=/home/botipi-4/PoliticMarket/.env.pipeline
Environment=PATH=/home/botipi-4/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/botipi-4/PoliticMarket/scripts/run-daily-pipeline.sh
TimeoutStartSec=2h

[Install]
WantedBy=multi-user.target
