# n8n Self-Hosted Configuration
# Copy this file to .env and fill in real values before deploying.
#   cp .env.example .env

# n8n access credentials
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# Encryption key for credential storage (generate a random 32+ char string)
# Example: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Public webhook URL (set to your domain with HTTPS)
WEBHOOK_URL=https://n8n.yourdomain.com/
